# IBVAP Frontend — Local Development
# Active backend URL. Points to the FastAPI server.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Set to "false" → call FastAPI backend
# Set to "true" → use built-in mock data
VITE_USE_MOCK=false

# WebSocket URL for real-time detection events (future)
VITE_WS_URL=ws://127.0.0.1:8000/ws/detections
