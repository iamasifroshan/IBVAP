# IBVAP Frontend — Production / Staging
# Override VITE_USE_MOCK to "false" once the FastAPI backend is deployed.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=true
VITE_WS_URL=ws://localhost:8000/ws/detections

# CCTV Camera Credentials (DO NOT COMMIT REAL PASSWORDS)
RTSP_USERNAME=<camera_username>
RTSP_PASSWORD=<camera_password>
RTSP_HOST=192.168.1.43
RTSP_PORT=554
RTSP_CHANNEL=101
